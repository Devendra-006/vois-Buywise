# ========================================================
# BuyWise Shopping Intelligence Environment Configuration
# ========================================================

# Runtime Mode
NODE_ENV=development
PORT=4000

# PostgreSQL Database (Required in production - Neon / Supabase / Local Docker)
# Local Docker: postgresql://buywise_user:buywise_secure_pass_2026@localhost:5432/buywise_db
DATABASE_URL=postgresql://buywise_user:buywise_secure_pass_2026@localhost:5432/buywise_db

# Redis Cache (Optional - Upstash Redis or Local Docker)
# Local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# LLM Provider (OpenRouter API)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Live Product Data Provider (SerpAPI Google Shopping gl=in)
# Get from: https://serpapi.com/
SERPAPI_KEY=

# Authentication Secret (Must be >= 32 characters in production)
JWT_SECRET=buywise-development-secret-jwt-key-minimum-32-chars-long
JWT_EXPIRES_IN=7d

# Internal Scheduled Cron Secret (Protects /internal/price-check)
CRON_SECRET=buywise-internal-cron-secret-token

# Email Alerts Service (Optional - Resend API)
# Get from: https://resend.com/
RESEND_API_KEY=
MAIL_FROM=BuyWise Alerts <alerts@buywise.in>

# Security & CORS Settings
CORS_ORIGIN=http://localhost:3000

# Demo Mode Flag (Set to false when live API keys are provided)
DEMO_MODE=true

# Public Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
